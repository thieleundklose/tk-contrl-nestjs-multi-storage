{
    "name": "@thieleundklose/nestjs-multi-storage",
    "version": "0.1.8",
    "description": "A multi-storage filesystem manager for NestJS, based on fs function names",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "keywords": [
        "nestjs-storage",
        "nestjs-filesystem",
        "nestjs-s3"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/jonathanarezki/nestjs-multi-storage.git"
    },
    "bugs": {
        "url": "https://github.com/jonathanarezki/nestjs-multi-storage/issues"
    },
    "homepage": "https://github.com/jonathanarezki/nestjs-multi-storage",
    "author": "Jonathan Arezki <arezki@webbar.dev>",
    "private": false,
    "license": "MIT",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "format": "prettier --write \"**/*.ts\"",
        "lint": "eslint 'lib/**/*.ts' --fix",
        "prepublish:npm": "npm run build",
        "publish:npm": "npm publish --access public",
        "prepublish:next": "npm run build",
        "publish:next": "npm publish --access public --tag next",
        "test:e2e": "jest --config ./tests/jest-e2e.json --runInBand",
        "test:e2e:dev": "jest --config ./tests/jest-e2e.json --runInBand --watch"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1096.0",
        "@aws-sdk/lib-storage": "^3.1096.0",
        "@aws-sdk/s3-request-presigner": "^3.1096.0",
        "@nestjs/common": "^9.0.8 || ^10.0.0"
    },
    "devDependencies": {
        "@types/node": "^18.19.130",
        "@types/node-fetch": "^2.6.13",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-prettier": "^4.2.5",
        "prettier": "^2.8.8",
        "reflect-metadata": "^0.1.14",
        "typescript": "^4.9.5"
    },
    "peerDependencies": {
        "@nestjs/common": "^9.0.0 || ^10.0.0",
        "@nestjs/core": "^9.0.0 || ^10.0.0"
    }
}
